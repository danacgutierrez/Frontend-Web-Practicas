// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Clase {
  id          Int       @id @default(autoincrement())
  nombre      String
  duracionMin Int
  descripcion String?
  horarios    Horario[]

  @@map("clases")
}

model Horario {
  id           Int           @id @default(autoincrement())
  claseId      Int
  clase        Clase         @relation(fields: [claseId], references: [id])
  dia          String
  horaInicio   String
  cupoMaximo   Int
  entrenador   String
  inscripcions Inscripcion[]

  @@map("horarios")
}

model Miembro {
  id           Int           @id @default(autoincrement())
  nombre       String
  correo       String        @unique
  activo       Boolean       @default(true)
  inscripcions Inscripcion[]

  @@map("miembros")
}

enum EstadoInscripcion {
  confirmada
  lista_espera
  cancelada
  asistio
}

model Inscripcion {
  id        Int               @id @default(autoincrement())
  horarioId Int
  horario   Horario           @relation(fields: [horarioId], references: [id])
  miembroId Int
  miembro   Miembro           @relation(fields: [miembroId], references: [id])
  estado    EstadoInscripcion @default(confirmada)
  creadoEn  DateTime          @default(now())

  @@unique([horarioId, miembroId])
  @@map("inscripciones")
}
